#!/usr/bin/env -S python3 -I
# Launcher. -I (isolated mode) keeps the current directory and PYTHON* variables
# off the import path, so starting the broker from inside an agent-writable
# project directory cannot make it import agent-planted modules (G1).
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from compose_broker.cli import main  # noqa: E402

sys.exit(main())
